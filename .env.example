# Copy to .env and edit. Never commit the real .env file.
VIDYAMARGA_ENV=development
SECRET_KEY=change-me-to-a-long-random-string

# mock = offline sandbox (default) | razorpay = Razorpay TEST mode
PAYMENT_PROVIDER=mock
ALLOW_MOCK_PAYMENTS=1

# Only needed when PAYMENT_PROVIDER=razorpay (use TEST keys from the Razorpay dashboard)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Set to 1 when serving over HTTPS
SESSION_COOKIE_SECURE=0
